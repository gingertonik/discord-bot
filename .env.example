# Copy this file to .env and fill it in. Lines starting with # are ignored. Never share or commit .env.
# Real environment variables win over this file, so `DISCORD_TOKEN=... python bot.py` still works.

# Bot token: developer portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's ID (Developer Mode on, right-click the server, Copy Server ID).
# Makes slash commands appear instantly instead of within about an hour.
GUILD_ID=

# Music: leave these blank to switch it off.
NAVIDROME_URL=http://192.168.1.50:4533
NAVIDROME_USER=
NAVIDROME_PASS=

# !rules: by default the bot uses the channel with "rules" in its name and that channel's oldest message.
RULES_CHANNEL_ID=
RULES_MESSAGE_ID=

# Pokémon game: where its SQLite file lives (default: data/pokemon.db next to bot.py).
# POKEMON_DB=
